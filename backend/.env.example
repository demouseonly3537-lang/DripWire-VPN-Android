# Copy this file to .env and fill in real values before starting the server.

# The one admin account for the panel. Change these before exposing the server publicly.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Random secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on.
PORT=8787
