<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="start"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_chat_bubble_admin"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/bubbleImage"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/cd_support_photo"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/bubbleBodyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Try reconnecting now, server was restarted." />
    </LinearLayout>

    <TextView
        android:id="@+id/bubbleTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        tools:text="21:06" />
</LinearLayout>
