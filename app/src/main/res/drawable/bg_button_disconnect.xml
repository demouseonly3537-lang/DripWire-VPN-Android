<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient "Disconnect" button — warm red/orange instead of the connect state's cool neon. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/neon_red_dim"
        android:endColor="#7F1D1D"
        android:type="linear" />
    <corners android:radius="28dp" />
</shape>
